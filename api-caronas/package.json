{
  "name": "api-caronas",
  "version": "1.0.0",
  "description": "API REST para sistema de caronas universitárias com autenticação JWT, validação OCR de documentos e chat em tempo real via Socket.io",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:tunnel": "concurrently --kill-others \"npm run dev\" \"npm run ngrok\"",
    "test": "jest",
    "ngrok": "ngrok http --url=showy-slapstick-escapade.ngrok-free.dev 3000"
  },
  "keywords": [
    "caronas",
    "api",
    "nodejs",
    "express",
    "mysql",
    "jwt",
    "socket.io",
    "ocr"
  ],
  "author": "Mogli-txc",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fs-extra": "^11.3.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "pdf-to-img": "^6.0.0",
    "pdfjs-dist": "^5.6.205",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
